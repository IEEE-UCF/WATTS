# WATTS — environment template. `pnpm bootstrap` copies this to ./.env (gitignored).
# Edit ./.env, not this file. Every app and package reads ./.env via
# @watts/config `loadRootEnv()`; values already in the real environment (Vercel/CI) win.
#
# Host rule: SERVER-SIDE connection strings (DATABASE_URL, S3_ENDPOINT) use 127.0.0.1 —
# on Windows `localhost` resolves to IPv6 (::1) first while Docker publishes IPv4, which
# hangs the Postgres/S3 clients. BROWSER-FACING URLs (NEXTAUTH_URL, S3_PUBLIC_BASE_URL)
# use localhost, and you should browse the app at http://localhost:3000 — keep the host
# consistent or the session cookie won't stick.

# ── App environment ─────────────────────────────────────────────
APP_ENV=local                                    # local | development | production
NODE_OPTIONS=--dns-result-order=ipv4first

# ── Database — local Docker Postgres ───────────────────────────
DB_PROVIDER=local                                # local (postgres-js) | neon (serverless HTTP)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/watts

# ── Object storage — local Docker MinIO ───────────────────────
STORAGE_PROVIDER=local                           # local (S3/MinIO) | vercel (Blob)
NEXT_PUBLIC_STORAGE_PROVIDER=local               # must match STORAGE_PROVIDER
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PUBLIC=media-public
S3_BUCKET_PRIVATE=resumes-private
S3_PUBLIC_BASE_URL=http://localhost:9000/media-public   # browser-facing (image src)

# ── Auth ──────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000                       # browse the app here
NEXTAUTH_SECRET=dev-only-not-a-secret-change-me

# Local admin bypass — log in as a seeded user without Discord.
# /api/dev/login only works when BOTH of these hold (never true in a deployment).
ALLOW_DEV_LOGIN=true
DEV_ADMIN_EMAIL=admin@watts.local

# Discord OAuth — only needed to exercise the real sign-in flow locally.
# Leave blank to use the dev-login bypass above. Local redirect URL:
#   http://127.0.0.1:3000/api/auth/callback/discord   (run `pnpm --filter @watts/web dev:https`)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Feature flags ─────────────────────────────────────────────
RESUME_UPLOAD_AUDIENCE=officers                  # admins | officers | members
