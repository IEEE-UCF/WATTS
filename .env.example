# ══════════════════════════════════════════════════════════════════════════════
#  WATTS — one env file for the whole monorepo.
#
#  `pnpm bootstrap` copies this to ./.env (gitignored). Edit ./.env directly —
#  put real secret values there too, it is never committed. Every app and
#  package reads it via @watts/config `loadRootEnv()`.
#
#  HOST RULE — server-side connection strings (DATABASE_URL, S3_ENDPOINT) use
#  127.0.0.1: on Windows `localhost` resolves to IPv6 first while Docker
#  publishes IPv4, which hangs the Postgres/S3 clients. Browser-facing URLs
#  (NEXTAUTH_URL, S3_PUBLIC_BASE_URL) use localhost, and you browse the app at
#  https://localhost:3050.
#
#  PORTS — the local stack lives in one block, 3050–3060:
#    3050 web · 3051 postgres · 3052 minio S3 · 3053 minio console
#    3054 drizzle studio · 3055 drizzle studio redirect (open this one)
#
#  Working on only one app? Leave the other sections as they are.
# ══════════════════════════════════════════════════════════════════════════════


# ── SHARED · every app ───────────────────────────────────────────────────────
APP_ENV=local                                  # local | development | production
NODE_OPTIONS=--dns-result-order=ipv4first       # Windows localhost/IPv6 guard

# Database — one local Postgres (infra/docker). Set DB_PROVIDER=neon + a cloud
# DATABASE_URL to use Neon instead.
DB_PROVIDER=local                              # local (postgres-js) | neon (serverless HTTP)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:3051/watts

# Object storage — one local MinIO (infra/docker). Set STORAGE_PROVIDER=vercel
# + BLOB_READ_WRITE_TOKEN to use Vercel Blob instead.
STORAGE_PROVIDER=local                         # local (S3/MinIO) | vercel (Blob)
S3_ENDPOINT=http://127.0.0.1:3052
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PUBLIC=media-public
S3_BUCKET_PRIVATE=resumes-private

# Discord application — the OAuth app. Its CLIENT_ID is used by the website's
# login and (later) the bot's slash-command registration. The bot's runtime
# TOKEN is separate, in the DISCORD BOT section. Real values → ./.env only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=


# ── WEBSITE · apps/ieeeucfcom ────────────────────────────────────────────────
# `pnpm dev` serves https (self-signed cert — click through). `pnpm --filter
# @watts/web dev:http` serves plain http; set NEXTAUTH_URL to http:// then.
NEXTAUTH_URL=https://localhost:3050
NEXTAUTH_SECRET=dev-only-not-a-secret-change-me
NEXT_PUBLIC_STORAGE_PROVIDER=local             # must match STORAGE_PROVIDER
S3_PUBLIC_BASE_URL=http://localhost:3052/media-public   # browser-facing (image src)
RESUME_UPLOAD_AUDIENCE=officers                # admins | officers | members

# Local sign-in is Discord OAuth, same as production. Create your own Discord
# application, add https://localhost:3050/api/auth/callback/discord as a redirect,
# and put its id/secret in DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET above. Set
# DEV_ADMIN_DISCORD_ID (DISCORD BOT section) to your Discord user id so your login
# links to the seeded admin. DEV_ADMIN_EMAIL is the seeded admin's email.
DEV_ADMIN_EMAIL=admin@watts.local


# ── GOOGLE CALENDAR · apps/ieeeucfcom + apps/jobs ────────────────────────────
# Service-account access to the chapter Google Calendar. Events created on the
# website mirror here. Leave blank for local dev / CI — the sync client no-ops and
# events are saved with syncStatus 'skipped'.
#
#   1. Google Cloud console → a project → enable "Google Calendar API".
#   2. Create a service account, add a JSON key, download it.
#   3. Share the calendar with the service-account email
#      (…@….iam.gserviceaccount.com) with "Make changes to events".
#   4. Put the key here as ONE line: base64 of the JSON file is easiest
#      (`base64 -w0 key.json`), raw JSON also works.
GOOGLE_SERVICE_ACCOUNT_JSON=Make your Own or get with Dawn on a service account, this is one of the more annoying things
GOOGLE_CALENDAR_ID=ieee.ucf@gmail.com           # or a …@group.calendar.google.com id


# ── DISCORD BOT · apps/dbot ──────────────────────────────────────────────────
# Fill these when working on the bot (`pnpm dev:bot`). Each developer needs their
# OWN Discord application + bot token + a private test guild — one token supports
# only one live gateway connection. DATABASE_URL is shared (SHARED section above).
# NOTE: the bot is a SEPARATE Discord application from the website's OAuth app.
# Its client id is DISCORD_CLIENT_ID_BOT here — the website's stays DISCORD_CLIENT_ID.
DISCORD_TOKEN=
DISCORD_CLIENT_ID_BOT=                         # bot application id (optional — derived from the token if unset)
MAIN_SERVER_ID=                                # your test guild id
OWNER_ID=                                      # your Discord user id → treated as ADMINISTRATOR
OWNER_NAME=
DEV_ADMIN_DISCORD_ID=                          # your Discord user id → written onto the seeded dev admin
ROLE_REMINDER_ID=
ROLE_ASSISTANCE_ADMIN_ID=
ROLE_ASSISTANCE_SOFTWARE_ID=
CHANNEL_CALENDAR_ID=
CHANNEL_REMINDERS_ID=
CHANNEL_ASSISTANCE_ID=
CHANNEL_GENERAL_ID=
CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/ieee.ucf%40gmail.com/public/basic.ics
EVENTS_AUTOMATION_ENABLED=false
EVENTS_AUTOMATION_INTERVAL_MINS=30
EVENT_REMINDERS_ENABLED=false
EVENT_REMINDERS_MINUTES=60
# Mirror website "global" events to Discord guild scheduled events (MAIN_SERVER_ID
# only). The bot's role needs the "Manage Events" permission in that guild.
DISCORD_EVENT_SYNC_ENABLED=false
DISCORD_EVENT_SYNC_INTERVAL_MINS=15
PING_EVENT_CREATORS=false
DEBUG=false


# ── CRON JOBS · apps/jobs ────────────────────────────────────────────────────
# Not built yet — placeholder for the archive-to-OneDrive / calendar-sync jobs.
# RCLONE_REMOTE=onedrive
# ARCHIVE_ROOT=IEEE-Website
# ARCHIVE_INCLUDE_RESUMES=false
