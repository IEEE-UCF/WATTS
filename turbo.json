{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["pnpm-lock.yaml", ".env", "packages/tsconfig/*.json"],
	"globalPassThroughEnv": [
		"NODE_ENV",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_URL",
		"VERCEL_BRANCH_URL",
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"NEXTAUTH_URL",
		"NEXTAUTH_SECRET",
		"DISCORD_CLIENT_ID",
		"DISCORD_CLIENT_SECRET",
		"BLOB_READ_WRITE_TOKEN",
		"BLOB_RW_TOKEN_PUBLIC",
		"BLOB_RW_TOKEN_PRIVATE",
		"S3_ENDPOINT",
		"S3_REGION",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY",
		"S3_BUCKET_PUBLIC",
		"S3_BUCKET_PRIVATE",
		"S3_PUBLIC_BASE_URL",
		"DEV_ADMIN_EMAIL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"],
			"env": [
				"APP_ENV",
				"DB_PROVIDER",
				"STORAGE_PROVIDER",
				"NEXT_PUBLIC_STORAGE_PROVIDER",
				"RESUME_UPLOAD_AUDIENCE"
			]
		},
		"lint": {},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"env": ["APP_ENV"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
