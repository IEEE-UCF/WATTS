{
  "name": "@watts/storage",
  "version": "0.0.0",
  "private": true,
  "description": "Storage abstraction for WATTS — S3/MinIO + Vercel Blob adapters, upload authorize/finalize, key helpers. Framework-neutral (no next / next-auth).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./finalize": "./src/finalize.ts",
    "./keys": "./src/keys.ts",
    "./audience": "./src/audience.ts",
    "./env": "./src/env.ts",
    "./types": "./src/types.ts",
    "./client": "./src/client.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@vercel/blob": "^2.8.0",
    "@watts/db": "workspace:*",
    "browser-image-compression": "^2.0.2",
    "drizzle-orm": "0.44.7",
    "exifr": "^7.1.3"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@watts/eslint-config": "workspace:*",
    "@watts/tsconfig": "workspace:*",
    "eslint": "^9.39.4"
  }
}
