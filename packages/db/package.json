{
  "name": "@watts/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema + driver-agnostic client + migrations for WATTS. Framework-neutral: no next / react / @trpc.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio --port 3054",
    "db:check": "drizzle-kit check",
    "lint": "eslint ."
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "@watts/config": "workspace:*",
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3",
    "postgres": "3.4.8"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "@watts/eslint-config": "workspace:*",
    "@watts/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.4"
  }
}
