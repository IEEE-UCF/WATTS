{
  "name": "watts",
  "version": "0.0.0",
  "private": true,
  "description": "IEEE@UCF monorepo — website (apps/ieeeucfcom) and Discord bot (apps/dbot).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IEEE-UCF/WATTS.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "web": "pnpm --filter @watts/web",
    "bot": "pnpm --filter @watts/bot",
    "lint": "pnpm -r --parallel lint",
    "build": "pnpm -r build",
    "bootstrap": "node infra/scripts/bootstrap.mjs",
    "dev": "pnpm --filter @watts/web dev",
    "infra:up": "node infra/scripts/up.mjs",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml --profile setup down",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml --profile setup down -v",
    "db:generate": "pnpm --filter @watts/web db:generate",
    "db:migrate": "pnpm --filter @watts/web db:migrate",
    "db:studio": "pnpm --filter @watts/web db:studio",
    "db:seed": "pnpm --filter @watts/web db:seed",
    "db:reset": "pnpm infra:reset && pnpm infra:up && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
