    "url": "git+https://github.com/IEEE-UCF/WATTS.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "web": "pnpm --filter @watts/web",
